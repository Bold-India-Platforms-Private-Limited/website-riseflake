# Copy this file to .env.local and fill in your values.
# .env.local is gitignored; never commit real secrets.

# Riseflake backend API base URL
NEXT_PUBLIC_API_BASE_URL=https://backend.riseflake.com/api/v1/website

# Riseflake web app (app.riseflake.com) base URL — used for "Apply" hand-off links.
# For local dev point it at your running web app, e.g. http://localhost:5174
NEXT_PUBLIC_APP_BASE_URL=https://app.riseflake.com

# Google Analytics measurement ID (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
