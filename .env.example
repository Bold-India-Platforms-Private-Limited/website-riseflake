# Copy this file to .env.local and fill in your values.
# .env.local is gitignored; never commit real secrets.

# Riseflake backend API base URL
NEXT_PUBLIC_API_BASE_URL=https://backend.riseflake.com/api/v1/website

# Riseflake web app (app.riseflake.com) base URL — used for "Apply" hand-off links.
# For local dev point it at your running web app, e.g. http://localhost:5174
NEXT_PUBLIC_APP_BASE_URL=https://app.riseflake.com

# Google Analytics measurement ID (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# 404-tracking beacon (top-level /api/v1 route, not under /api/v1/website)
# NEXT_PUBLIC_TRACK_404_URL=http://localhost:8000/api/v1/track-404

# Cloudflare Turnstile site key (public) for the contact form.
# Same widget used across the webapp's auth forms — get the value from
# dash.cloudflare.com/turnstile (frontend-riseflake's VITE_TURNSTILE_SITE_KEY).
# The widget's allowed hostnames in the Cloudflare dashboard must include riseflake.com.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADR3vt6rRrmI-T-k
