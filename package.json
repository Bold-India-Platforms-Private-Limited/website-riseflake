{
  "name": "riseflake-landing",
  "version": "1.0.0",
  "description": "SEO-friendly job portal and professional networking landing page",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:resume": "cd resume && cp ../.env .env || true && npm install --no-package-lock && npm run build",
    "prebuild": "npm run build:resume && rm -rf public/resume && cp -R resume/out public/resume",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next build"
  },
  "dependencies": {
    "dompurify": "^3.3.1",
    "lucide-react": "^0.563.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.3.0",
    "react-router-dom": "^7.13.0",
    "styled-components": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "25.2.1",
    "@types/react": "19.2.13",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19"
  }
}
