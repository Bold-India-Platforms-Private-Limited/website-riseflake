{
  "name": "riseflake-landing",
  "version": "1.0.0",
  "description": "riseflake.com \u2014 SEO-first job portal & professional network website (Next.js static export on Cloudflare Pages)",
  "private": true,
  "scripts": {
    "predev": "test -f .build/manifest.json || CF_LIMIT_PER_ROUTE=25 node scripts/cf/build-manifest.mjs",
    "dev": "next dev",
    "build": "node scripts/cf/build.mjs",
    "build:manifest": "node scripts/cf/build-manifest.mjs",
    "build:resume": "bash scripts/build-resume.sh",
    "build:next": "next build",
    "preview": "npx --yes wrangler@4 pages dev out",
    "smoke": "node scripts/cf/smoke.mjs",
    "lint": "next lint",
    "seo-diff": "node scripts/cf/seo-diff.mjs"
  },
  "dependencies": {
    "dompurify": "^3.3.1",
    "is-generator-function": "^1.1.2",
    "lucide-react": "^0.563.0",
    "next": "^15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.3.0",
    "react-router-dom": "^7.13.0",
    "styled-components": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "25.2.1",
    "@types/react": "19.2.13",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=22.18"
  }
}
